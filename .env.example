# Copiare in .env e compilare. Il file .env non va mai messo nel repository.

ENVIRONMENT=production
APP_TIMEZONE=Europe/Rome
WEB_PORT=8000

# Database
POSTGRES_USER=websentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=websentinel

# Chiave per firmare i cookie di sessione (es. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me
# Chiave HMAC-SHA256 per pseudonimizzare gli IP dei log (fase 5)
IP_HMAC_KEY=change-me

# Cookie di sessione: true dietro HTTPS (produzione), false solo in sviluppo locale
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Primo utente amministratore, creato da scripts/seed.py se non esistono utenti
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-12-chars

# Alert
ALERT_DEFAULT_RECIPIENT=alert@example.com
# Any SMTP server. Example with Resend (the API key is the password; never commit it):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend
#   SMTP_PASSWORD=re_xxxxxxxxxxxx  SMTP_FROM=Web Sentinel <alert@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=
# Indirizzo pubblico della dashboard, usato per i link nelle mail.
APP_BASE_URL=http://localhost:8000
# Fuori produzione le mail restano nel raccoglitore locale (Mailpit). Con true partono davvero
# con i parametri SMTP qui sopra, ma tutte verso MAIL_TEST_RECIPIENT soltanto.
MAIL_REAL_DELIVERY=false
MAIL_TEST_RECIPIENT=
# Fallimenti consecutivi prima di aprire un incidente, e attesa (secondi) prima di ripetere
# un controllo appena fallito.
INCIDENT_FAILURE_THRESHOLD=3
FAILURE_RETRY_SECONDS=60

# Worker
WORKER_TICK_SECONDS=10
WORKER_MAX_CONCURRENCY=10
WORKER_STALE_SECONDS=300

# Deploy (da definire): nome DNS interno e reverse proxy aziendale
# PUBLIC_BASE_URL=https://websentinel.example.internal
